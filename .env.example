# Copiar a .env y completar los valores vacíos:  cp .env.example .env
# .env está excluido de Git; este archivo NO debe contener secretos reales.

# --- PostgreSQL: administrador (crea la base de datos, el schema y el seed) ---
POSTGRES_DB=vp_finanzas
POSTGRES_USER=vp_admin
POSTGRES_PASSWORD=

# --- PostgreSQL: usuario de la aplicación (privilegios mínimos, lo usa el backend) ---
APP_DB_USER=vp_app
APP_DB_PASSWORD=

# --- Solo desarrollo con Docker: puertos del host (127.0.0.1) ---
DB_PORT=5432
BACKEND_PORT=8000
