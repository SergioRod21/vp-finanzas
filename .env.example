# =============================================================================
# Variables de entorno: plantilla para DESARROLLO LOCAL
#
#   cp .env.example .env
#
# Los valores de este archivo funcionan tal cual para probar el proyecto en tu
# máquina. Son públicos (están en el repositorio): NO los uses en ningún otro
# entorno. Para generar valores propios:  openssl rand -hex 32
# .env está excluido de Git. Ver la decisión S4 en docs/decisiones-tecnicas.md.
# =============================================================================

# Entorno de ejecución: development | production
# En production, el backend se niega a arrancar con el JWT_SECRET de ejemplo.
APP_ENV=development

# --- PostgreSQL: administrador (crea la base de datos, el schema y el seed) ---
# SOLO DESARROLLO LOCAL
POSTGRES_DB=vp_finanzas
POSTGRES_USER=vp_admin
POSTGRES_PASSWORD=dev_admin_local_only_7f3c9a2e

# --- PostgreSQL: usuario de la aplicación (privilegios mínimos, lo usa el backend) ---
# SOLO DESARROLLO LOCAL. Solo letras, números y guiones bajos: forma parte de la URL de conexión.
APP_DB_USER=vp_app
APP_DB_PASSWORD=dev_app_local_only_4b8e21d0

# --- Sesión: secreto para firmar los JWT (mínimo 32 caracteres) ---
# SOLO DESARROLLO LOCAL
JWT_SECRET=dev_jwt_secret_local_only_9d2f6a1c8e4b7a3f5c0d
# Duración de la sesión en minutos (entre 5 y 1440)
JWT_EXPIRE_MINUTES=60

# --- Usuarios de demostración: contraseña común (ver "Usuarios de prueba" en el README) ---
# SOLO DESARROLLO LOCAL. La lee db/05-seed-usuarios.sql al inicializar la base de datos.
SEED_USER_PASSWORD=Demo.Finanzas.2026

# --- Puerto del host (127.0.0.1) donde se publica el portal ---
FRONTEND_PORT=8080

# --- Solo desarrollo con Docker: puertos del host (127.0.0.1) ---
DB_PORT=5432
BACKEND_PORT=8000
